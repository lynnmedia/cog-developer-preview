define entity "observed-signal" {
  kind: observation
  level: L1
  source: "scanner-1"
  value: "threshold-crossed"
}

define entity "classified-event" {
  kind: event
  level: L2
  operation: classify
  source: "scanner-1"
  value: "threshold-crossed"
}

define entity "response-action" {
  kind: action
  level: L2
  value: "inspect"
}

relate "observed-signal" -> "classified-event" {
  kind: classified-as
  operation: classify
}

relate "classified-event" -> "response-action" {
  kind: causes
  operation: "relate"
}

emit {
  target: "classified-event"
  kind: classify-and-relate
}

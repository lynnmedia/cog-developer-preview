{
  "name": "@winmedia/cog-core",
  "version": "0.3.0",
  "description": "Core cognition-kernel and pipeline runner for the Cog language",
  "author": "Lynn Media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynnmedia/cog-developer-preview.git",
    "directory": "packages/cog-core"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cog": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "learning"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist learning",
    "assemble:learning": "node ./scripts/assembleLearningPack.cjs",
    "prepack": "npm run build && npm run assemble:learning",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 src/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "directories": {
    "example": "examples"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/lynnmedia/cog-developer-preview/issues"
  },
  "homepage": "https://github.com/lynnmedia/cog-developer-preview#readme"
}

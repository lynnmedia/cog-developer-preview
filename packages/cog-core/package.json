{
  "name": "@cog/core",
  "version": "0.3.0",
  "description": "Core cognition-kernel and pipeline runner for the Cog language",
  "author": "Lynn Media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynnmedia/cog.git",
    "directory": "packages/cog-core"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && tsx --test src/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "directories": {
    "example": "examples"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/lynnmedia/cog/issues"
  },
  "homepage": "https://github.com/lynnmedia/cog#readme"
}

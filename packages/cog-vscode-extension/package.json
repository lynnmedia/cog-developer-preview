{
  "name": "cog-vscode-extension",
  "displayName": "Cog Language Support",
  "description": "Minimal extension scaffold for the .cog language",
  "version": "0.1.0",
  "publisher": "lynnmedia",
  "author": "Lynn Media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynnmedia/cog-developer-preview.git",
    "directory": "packages/cog-vscode-extension"
  },
  "homepage": "https://github.com/lynnmedia/cog-developer-preview#readme",
  "bugs": {
    "url": "https://github.com/lynnmedia/cog-developer-preview/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cog",
        "aliases": [
          "Cog",
          "cog"
        ],
        "extensions": [
          ".cog"
        ]
      }
    ],
    "commands": [
      {
        "command": "cog.validateWorkflow",
        "title": "Cog: Validate Workflow"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
